# Generate two independent 32-byte values, base64 encoded.
ADMIN_API_TOKEN=replace-with-a-long-random-token
TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# OAuth application secrets remain server-side. Client IDs may be configured in wrangler.jsonc.
LINKEDIN_CLIENT_SECRET=
META_APP_SECRET=
INSTAGRAM_APP_SECRET=

# TikTok Content Posting: creator_inbox_draft accounts (video.upload).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# TikTok API for Business: direct_publish organic accounts and advertising.
# Direct publish requires Account User, Video Publish, and Photo Publish app permissions.
TIKTOK_BUSINESS_CLIENT_ID=
TIKTOK_BUSINESS_CLIENT_SECRET=
# Advertising OAuth may use the full authorization URL issued by TikTok for Business.
TIKTOK_BUSINESS_AUTHORIZATION_URL=
