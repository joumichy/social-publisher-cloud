{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "social-publisher-export-review",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": []
  },
  "vars": {
    "PUBLIC_BASE_URL": "http://127.0.0.1:8787",
    "META_GRAPH_VERSION": "v26.0",
    "LINKEDIN_VERSION": "202608",
    "MEDIA_RETENTION_DAYS": "7",
    "MAX_ATTEMPTS": "8"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "social-publisher",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "social-publisher-export-review-media"
    }
  ]
}
